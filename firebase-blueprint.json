{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account settings and AI persona preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "aiGuideStyle": {
          "type": "string",
          "enum": ["empathetic", "socratic", "philosophical", "action_oriented", "mindful"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId"]
    },
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "Private reflective journal entry written by user",
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "mood": {
          "type": "string"
        },
        "tags": {
          "type": "array"
        },
        "aiSummary": {
          "type": "string"
        },
        "aiInsights": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["entryId", "userId", "content", "createdAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Multi-turn conversation message between user and Gemini AI",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"]
        },
        "content": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["messageId", "userId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profile document"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": {
        "$ref": "#/entities/JournalEntry"
      },
      "description": "User's private journal entries"
    },
    "/users/{userId}/entries/{entryId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Multi-turn reflection chat messages attached to entry"
    }
  }
}
